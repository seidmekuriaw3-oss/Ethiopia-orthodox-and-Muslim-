# Copy to .env for local development and replace every placeholder.
SECRET_KEY=generate-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=generate-a-strong-password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=semiradb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/semiradb
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=generate-a-random-webhook-secret
REPLIT_DEV_DOMAIN=
DEBUG=False
SESSION_COOKIE_SECURE=False
